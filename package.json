{
  "name": "huskylens-llm-local-app",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "concurrently -k -n server,web -c cyan,green \"tsx src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev": "npm run start",
    "check": "npm run check:ui && npm run build",
    "build": "tsc --noEmit && vite build",
    "check:ui": "tsx scripts/check-ui.ts",
    "doctor": "tsx scripts/doctor.ts",
    "package:windows-student": "node scripts/package-windows-student.mjs"
  },
  "dependencies": {
    "@fontsource/pretendard": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.16.0",
    "openai": "^5.12.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19"
  }
}
